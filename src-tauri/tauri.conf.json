{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YOUR DAY IS DYING",
  "version": "1.0.0",
  "identifier": "com.ydid.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "YOUR DAY IS DYING",
        "width": 1080,
        "height": 760,
        "minWidth": 320,
        "minHeight": 180,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
