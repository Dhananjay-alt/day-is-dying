{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YOUR DAY IS DYING",
  "version": "1.0.0",
  "identifier": "com.ydid.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "YOUR DAY IS DYING",
        "width": 1100,
        "height": 780,
        "minWidth": 720,
        "minHeight": 500,
        "resizable": true,
        "visible": true
      },
      {
        "label": "hud",
        "title": "YDID HUD",
        "url": "/index.html?view=hud",
        "width": 320,
        "height": 220,
        "minWidth": 200,
        "minHeight": 50,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "YOUR DAY IS DYING",
    "shortDescription": "Personal time-monitoring instrument",
    "longDescription": "A desktop time-awareness instrument that makes you physically aware that your day is disappearing in real time.",
    "copyright": "Copyright 2026 YOUR DAY IS DYING",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
